<UserControl x:Class="MkOptic.Views.DocumentSearchBar"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MkOptic.Views"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:DataType="views:DocumentSearch" Width="360" VerticalAlignment="Center">
    <Border x:Name="SearchChrome" Classes="FindChrome" Height="34" Padding="9,0,4,0">
        <Grid ColumnDefinitions="18,*,Auto,Auto">
            <mi:MaterialIcon Kind="Magnify" Foreground="{DynamicResource SukiLowText}"
                             VerticalAlignment="Center" IsHitTestVisible="False" />
            <TextBox x:Name="QueryInput" Grid.Column="1" Classes="FindInput" PlaceholderText="Find (Ctrl+F)"
                     AutomationProperties.Name="Find in current document"
                     Text="{Binding Query, Mode=TwoWay}" ToolTip.Tip="{Binding TargetLabel}" />
            <TextBlock Grid.Column="2" Text="{Binding ResultLabel}" MinWidth="44" Margin="6,0,8,0"
                       VerticalAlignment="Center" TextAlignment="Center" FontSize="11"
                       Foreground="{DynamicResource SukiLowText}" IsVisible="{Binding HasQuery}" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button x:Name="PreviousMatch" Classes="FindAction" Command="{Binding PreviousCommand}"
                        ToolTip.Tip="Previous match (Shift+Enter / Shift+F3)" AutomationProperties.Name="Previous match">
                    <mi:MaterialIcon Kind="ChevronUp" />
                </Button>
                <Button x:Name="NextMatch" Classes="FindAction" Command="{Binding NextCommand}"
                        ToolTip.Tip="Next match (Enter / F3)" AutomationProperties.Name="Next match">
                    <mi:MaterialIcon Kind="ChevronDown" />
                </Button>
                <Border Width="1" Height="14" Margin="3,0" Background="{DynamicResource FindInputBorder}" />
                <Button x:Name="ClearSearch" Classes="FindAction" Command="{Binding ClearCommand}"
                        ToolTip.Tip="Clear search (Escape)" AutomationProperties.Name="Clear search">
                    <mi:MaterialIcon Kind="Close" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
