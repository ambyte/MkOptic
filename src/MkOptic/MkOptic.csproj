<?xml version="1.0" encoding="UTF-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <RootNamespace>MkOptic</RootNamespace>
        <AssemblyName>MkOptic</AssemblyName>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\mkoptic.ico</ApplicationIcon>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <!-- Minimal: reload only the changed file. Balanced/Aggressive also reload MainWindow (SukiWindow),
             whose WndProc snap-layout hook then crashes on a detached visual. -->
        <HotAvaloniaMode>Minimal</HotAvaloniaMode>
    </PropertyGroup>
    <!-- Used by `dotnet publish -p:PublishSingleFile=true`: one self-contained executable (see the release workflow). -->
    <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
        <SelfContained>true</SelfContained>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    </PropertyGroup>
    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
        <!-- Defaults and the sample are embedded so the app can be published as a single file. -->
        <EmbeddedResource Include="appsettings.json"
                          LogicalName="appsettings.json" />
        <EmbeddedResource Include="Samples\welcome.md"
                          LogicalName="welcome.md" />
        <!-- Development overrides are for local debugging only and are not shipped. -->
        <None Update="appsettings.Development.json"
              CopyToOutputDirectory="PreserveNewest"
              Condition="'$(Configuration)' == 'Debug'" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Fonts.Inter" />
        <PackageReference Include="SukiUI" />
        <PackageReference Include="Material.Icons.Avalonia" />
        <PackageReference Include="Avalonia.AvaloniaEdit" />
        <PackageReference Include="AvaloniaEdit.TextMate" />
        <PackageReference Include="LiveMarkdown.Avalonia" />
        <PackageReference Include="LiveMarkdown.Avalonia.Math" />
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
        <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
        <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
        <PackageReference Include="Microsoft.Extensions.Logging" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
        <PackageReference Include="Avalonia.Markup.Xaml.Loader"
                          PrivateAssets="All"
                          Publish="True" />
        <PackageReference Include="HotAvalonia"
                          Condition="'$(Configuration)' == 'Debug'"
                          PrivateAssets="All"
                          Publish="True" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\MkOptic.Core\MkOptic.Core.csproj" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="MkOptic.Tests" />
    </ItemGroup>
</Project>
