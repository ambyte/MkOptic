{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "Appearance": {
    "BaseTheme": "Dark",
    "AccentColor": "Blue"
  },
  "Editor": {
    "PreviewDelayMilliseconds": 250,
    "MaxFileSizeMegabytes": 20,
    "FileExtensions": [ ".md", ".markdown", ".mdown", ".mkd", ".txt" ],
    "DefaultViewMode": "Preview",
    "FontSize": 14,
    "FontFamily": "Cascadia Code, Consolas, JetBrains Mono, Menlo, monospace",
    "WordWrap": true,
    "ShowLineNumbers": true
  }
}
